---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { sections } from '../data/sections';
import { icon } from '../lib/icons';

interface Props {
  title?: string;
  description?: string;
  image?: string; // imagen para compartir (ruta local); por defecto /og.png
  breadcrumbs?: { name: string; path: string }[]; // ruta de migas para Google (ej. Pokédex › Ralts)
}
const {
  title,
  description = 'Guía de Cobblemon para el servidor Diosesmon: Pokédex con spawns, crianza 6x31, evoluciones, megaevoluciones, interacciones y fusiones.',
  image = '/og.png',
  breadcrumbs,
} = Astro.props;
const fullTitle = title ? `${title} | Guía Diosesmon` : 'Guía Diosesmon: Pokédex, spawns y crianza 6x31 de Cobblemon';
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const here = Astro.url.pathname;
// Fondo: los Pokémon de las 6 secciones, tenues y quietos en los márgenes (x en %, y en vh, tamaño en px, giro en grados)
const backdrop = sections.flatMap((s, i) => [
  { id: s.art, x: i % 2 ? 90 : 3, y: 8 + i * 15, size: 110 + (i % 3) * 22, rot: i % 2 ? 8 : -8 },
]);
// Datos estructurados (schema.org) para que Google entienda qué es la web y muestre la ruta de migas
const jsonLd = [
  here === '/' && {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Guía Diosesmon',
    alternateName: ['Guía de Cobblemon Diosesmon', 'Diosesmon Fan Guía'],
    url: new URL('/', site).href,
    inLanguage: 'es',
    description,
  },
  breadcrumbs && {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Inicio', path: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.path, site).href,
    })),
  },
].filter(Boolean);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1b1e26" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Open Graph / redes (Discord, WhatsApp, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Guía Diosesmon" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? 'Guía Diosesmon'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      // La miniatura con [data-vt] viaja a la página nueva (y de vuelta). Va en el <head> porque "pagereveal"
      // ocurre antes que los demás scripts.
      (function () {
        var KEY = "vt";
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a");
          var el = a && a.querySelector("[data-vt]");
          if (!el) return;
          el.style.viewTransitionName = el.dataset.vt;
          sessionStorage.setItem(KEY, el.dataset.vt);
        });
        addEventListener("pageswap", function () {
          // saliendo de una ficha (botón atrás o enlace normal): su elemento principal vuelve a la lista
          if (sessionStorage.getItem(KEY)) return;
          var hero = document.querySelector("[data-vt-hero]");
          if (!hero) return;
          hero.style.viewTransitionName = hero.dataset.vt;
          sessionStorage.setItem(KEY, hero.dataset.vt);
        });
        addEventListener("pagereveal", function (e) {
          var name = sessionStorage.getItem(KEY);
          sessionStorage.removeItem(KEY);
          if (!name || !e.viewTransition) return;
          var el = document.querySelector("[data-vt=\"" + CSS.escape(name) + "\"]");
          if (!el) return;
          el.style.viewTransitionName = name;
          e.viewTransition.finished.finally(function () {
            el.style.viewTransitionName = "";
          });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <div class="backdrop" aria-hidden="true">
      {backdrop.map((b, i) => <img src={`/img/thumb/${b.id}.webp`} alt="" width={b.size} height={b.size} style={`left:${b.x}%;top:${b.y}vh;width:${b.size}px;height:${b.size}px;rotate:${b.rot}deg`} class={i > 3 ? 'wide' : undefined} />)}
    </div>
    <header id="top">
      <a href="/" class="brand" aria-label="Guía Diosesmon, inicio">
        <span class="ball" aria-hidden="true"></span>
        <span>Guía <strong>Diosesmon</strong></span>
      </a>

      <!-- PC: dock con efecto lupa -->
      <nav class="dock" aria-label="Secciones">
        {
          sections.map((s) => (
            <a href={`/${s.slug}/`} style={`--c: ${s.color}`} aria-current={here.startsWith(`/${s.slug}`) ? 'page' : undefined}>
              <img src={`/img/thumb/${s.art}.webp`} alt="" width="48" height="48" />
              <span class="label">{s.title}</span>
            </a>
          ))
        }
      </nav>

      <!-- celular: menú hamburguesa -->
      <button type="button" class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </header>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Secciones" hidden>
      {
        sections.map((s) => (
          <a href={`/${s.slug}/`} style={`--c: ${s.color}`} aria-current={here.startsWith(`/${s.slug}`) ? 'page' : undefined}>
            <img src={`/img/thumb/${s.art}.webp`} alt="" width="44" height="44" />
            <span>
              <strong>{s.title}</strong>
              <small>{s.desc}</small>
            </span>
          </a>
        ))
      }
    </nav>

    <main id="contenido">
      <slot />
    </main>

    <button type="button" class="to-top" id="to-top" aria-label="Volver arriba" hidden set:html={icon('top', 22)} />

    <footer>
      <p>
        Guía comunitaria no oficial para el servidor Diosesmon. Datos: Cobblemon y PokeAPI. Pokémon © Nintendo, Game Freak y The
        Pokémon Company.
      </p>
      <p><a href="/legal/">Privacidad y términos</a></p>
    </footer>

    <script>
      // Carga: quita el brillo de cada imagen cuando termina de cargar
      const loaded = (img: HTMLImageElement) => img.classList.add('ld');
      document.addEventListener('load', (e) => e.target instanceof HTMLImageElement && loaded(e.target), true);
      document.addEventListener('error', (e) => e.target instanceof HTMLImageElement && loaded(e.target), true);
      document.querySelectorAll('img').forEach((img) => img.complete && loaded(img));

      // Header fijo que se compacta y botón "volver arriba"
      const header = document.querySelector('header')!;
      const toTop = document.getElementById('to-top')!;
      const onScroll = () => {
        header.classList.toggle('scrolled', scrollY > 10);
        toTop.hidden = scrollY < 600;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      toTop.addEventListener('click', () => scrollTo({ top: 0 }));

      // Menú hamburguesa
      const burger = document.getElementById('burger')!;
      const menu = document.getElementById('mobile-menu')!;
      const setMenu = (open: boolean) => {
        menu.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        document.body.classList.toggle('menu-open', open);
      };
      burger.addEventListener('click', () => setMenu(menu.hidden));
      addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

    </script>
  </body>
</html>

<style>
  /* Fondo decorativo: quieto, a baja opacidad y fuera del flujo; no recibe clics ni resta legibilidad */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .backdrop img {
    position: absolute;
    opacity: 0.07;
    filter: grayscale(0.3);
  }
  @media (max-width: 900px) {
    .backdrop img.wide {
      display: none;
    }
    .backdrop img {
      opacity: 0.05;
    }
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--accent);
    border-radius: 8px;
  }
  header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    padding: 0 max(16px, calc((100% - 1100px) / 2 + 16px));
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    transition: box-shadow 0.2s;
    view-transition-name: site-header; /* el header queda fijo durante el cambio de página */
  }
  header.scrolled {
    box-shadow: 0 6px 18px var(--sh-dark);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 1.15rem var(--font-title);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand strong {
    color: var(--accent);
  }
  /* Pokéball hecha con CSS */
  .ball {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--text);
    background:
      radial-gradient(circle, var(--text) 0 3px, var(--bg) 3px 5px, transparent 5px),
      linear-gradient(var(--accent) 0 45%, var(--text) 45% 55%, #fff 55%);
    transition: transform 0.4s;
  }
  .brand:hover .ball {
    transform: rotate(360deg);
  }

  /* Dock con efecto lupa (como el de macOS) */
  .dock {
    display: none;
    align-items: center;
    gap: 10px;
    height: 58px;
    padding: 5px 12px;
    border-radius: 16px;
    box-shadow: var(--neu-in);
  }
  @media (min-width: 900px) {
    .dock {
      display: flex;
    }
  }
  .dock a {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--neu-sm);
    transition: transform 0.18s cubic-bezier(0.3, 0.7, 0.4, 1.5);
  }
  .dock img {
    width: 42px;
    height: 42px;
    pointer-events: none;
  }
  .dock a[aria-current='page'] {
    outline: 2px solid var(--c);
    outline-offset: 1px;
  }
  /* el que está bajo el mouse crece más y sus vecinos un poco */
  .dock a:hover,
  .dock a:focus-visible {
    transform: scale(1.35);
    z-index: 2;
  }
  .dock a:has(+ a:hover),
  .dock a:hover + a {
    transform: scale(1.15);
  }
  .dock a:has(+ a + a:hover),
  .dock a:hover + a + a {
    transform: scale(1.05);
  }
  .label {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--surface-2);
    box-shadow: var(--neu-sm);
    font-size: 0.62rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--c);
    opacity: 0;
    transform: translateX(-50%);
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .dock a:hover .label,
  .dock a:focus-visible .label {
    opacity: 1;
  }

  /* Menú hamburguesa (celular) */
  .burger {
    display: grid;
    gap: 5px;
    padding: 10px;
    background: var(--surface);
    border: 0;
    border-radius: 12px;
    cursor: pointer;
  }
  @media (min-width: 900px) {
    .burger {
      display: none;
    }
  }
  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition:
      transform 0.2s,
      opacity 0.2s;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 auto 0;
    z-index: 39;
    display: grid;
    gap: 10px;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding: 14px 16px 24px;
    background: var(--bg);
    box-shadow: 0 16px 30px var(--sh-dark);
    animation: drop 0.22s ease-out;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--neu-sm);
    text-decoration: none;
  }
  .mobile-menu a[aria-current='page'] {
    box-shadow: var(--neu-in);
  }
  .mobile-menu span {
    display: grid;
  }
  .mobile-menu strong {
    color: var(--c);
    font-family: var(--font-title);
  }
  .mobile-menu small {
    color: var(--muted);
    font-size: 0.78rem;
  }
  :global(body.menu-open) {
    overflow: hidden;
  }

  /* Volver arriba */
  .to-top {
    display: grid;
    place-items: center;
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    width: 48px;
    height: 48px;
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    animation: rise 0.25s ease-out;
  }
  .to-top[hidden] {
    display: none;
  }

  footer {
    padding: 20px 16px;
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
  }
  footer p {
    margin: 4px 0;
  }
</style>
