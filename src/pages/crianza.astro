  }
  .inv :global(.inv-miss) {
    grid-area: miss;
    justify-self: end;
    font-size: 0.85rem;
    font-weight: 700;
    color: #ff8a80;
  }
  .inv :global(.inv-miss.ok) {
    color: #69f0ae;
  }
  .auto {
    margin: 4px 0 10px;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 700;
    background: var(--accent);
    border: 0;
    border-radius: 10px;
    color: #fff;
    cursor: pointer;
  }
  .auto:disabled {
    background: var(--bg);
    color: #69f0ae;
    border: 1px solid #4cc46b;
    cursor: default;
  }
  .inv :global(.gin) {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }
  :global(.gs) {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-left: 2px;
    border-radius: 50%;
    color: #fff;
    font: 700 0.85rem system-ui, sans-serif;
    vertical-align: middle;
  }
  :global(.gs.m) {
    background: #1e88e5;
  }
  :global(.gs.f) {
    background: #d81b60;
  }
  .inv :global(.gin .gs) {
    width: 26px;
    height: 26px;
  }
  .inv :global(.gin .gs svg) {
    width: 17px;
    height: 17px;
  }
  .inv :global(.gin span) {
    font-size: 1.2rem;
    font-family: system-ui, sans-serif;
  }
  .inv :global(.gin.m span) {
    color: #42a5f5;
  }
  .inv :global(.gin.f span) {
    color: #f06292;
  }
  .inv :global(.gin.any span) {
    font-size: 0.85rem;
  }
  .inv :global(.gin.m input) {
    border-color: #42a5f5 !important;
    background: color-mix(in srgb, #42a5f5 14%, var(--surface)) !important;
  }
  .inv :global(.gin.f input) {
    border-color: #f06292 !important;
    background: color-mix(in srgb, #f06292 14%, var(--surface)) !important;
  }
  .inv :global(.gin input:disabled) {
    pointer-events: none; /* para que la burbuja salga al pasar por encima */
    opacity: 0.4;
    cursor: not-allowed;
  }
  /* burbuja con el motivo */
  .inv :global(.gin[data-tip]:hover::after),
  .inv :global(.gin[data-tip]:focus-within::after) {
    content: attr(data-tip);
    position: absolute;
    z-index: 20;
    right: 0;
    bottom: calc(100% + 8px);
    width: max-content;
    max-width: 220px;
    padding: 8px 10px;
    border-radius: 10px;
    background: #2b2f3a;
    border: 1px solid var(--border);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.45);
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--text);
    white-space: normal;
  }
  .inv :global(.gin[data-tip]:hover::before),
  .inv :global(.gin[data-tip]:focus-within::before) {
    content: '';
    position: absolute;
    right: 18px;
    bottom: calc(100% + 2px);
    border: 6px solid transparent;
    border-top-color: #2b2f3a;
  }
  :global(.link) {
    background: none;
    border: 0;
    padding: 0;
    color: #8ab4ff;
    text-decoration: underline;
    cursor: pointer;
  }

  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .opts :global(.opt) {
    position: relative;
  }
  .opts :global(.opt input) {
    position: absolute;
    opacity: 0;
  }
  .opts :global(.opt span) {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg);
    cursor: pointer;
  }
  .opts :global(.opt input:checked + span) {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .opts :global(.opt input:focus-visible + span) {
    outline: 2px solid var(--text);
  }
  .check {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.9rem;
  }

  /* resumen */
  #summary :global(.sum) {
    display: grid;
    gap: 10px;
  }
  /* PC: datos y Recios a la izquierda (cada uno en su fila), total a la derecha */
  @media (min-width: 900px) {
    #summary :global(.sum) {
      grid-template-columns: 1fr 280px;
      align-items: stretch;
    }
    #summary :global(.total) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  #summary :global(.kpis) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  #summary :global(.kpi),
  #summary :global(.items),
  #summary :global(.total) {
    display: grid;
    gap: 2px;
    align-content: center;
    padding: 10px;
    border-radius: 10px;
    background: var(--bg);
  }
  #summary :global(.kpi) {
    justify-items: center;
    text-align: center;
  }
  #summary :global(.k) {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  #summary :global(strong) {
    font: 700 1.6rem var(--font-title);
    line-height: 1.1;
  }
  #summary :global(small) {
    font-size: 0.78rem;
    color: var(--muted);
  }
  #summary :global(.tiles) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin-top: 6px;
  }
  @media (min-width: 560px) {
    #summary :global(.tiles) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  #summary :global(.tile) {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 1px;
    padding: 6px 4px;
    border-radius: 10px;
    border: 1px solid var(--c);
    background: color-mix(in srgb, var(--c) 14%, var(--surface));
    text-align: center;
  }
  #summary :global(.tile img) {
    image-rendering: pixelated;
  }
  #summary :global(.tile b) {
    font: 700 1.1rem var(--font-title);
  }
  #summary :global(.tile small) {
    font-size: 0.68rem;
    line-height: 1.2;
  }
  #summary :global(.total) {
    background: color-mix(in srgb, #4cc46b 16%, var(--bg));
    border: 1px solid #4cc46b;
  }
  #summary :global(.total strong) {
    font-size: 1.9rem;
    color: #8ff0a4;
  }
  :global(.mini) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.85rem;
  }
  :global(.mini img) {
    image-rendering: pixelated;
  }

  /* pasos */
  .views {
    display: inline-flex;
    margin-bottom: 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    overflow: hidden;
  }
  .views button {
    padding: 6px 14px;
    font-size: 0.85rem;
    background: var(--bg);
    border: 0;
    cursor: pointer;
  }
  .views button.on {
    background: var(--accent);
    color: #fff;
  }
  /* selector de pasos */
  .stepper {
    position: relative; /* el menú usa todo el ancho del selector */
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 56px;
    gap: 8px;
    align-items: stretch;
  }
  .nav-btn {
    font: 700 2rem/1 var(--font-title);
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: 14px;
    cursor: pointer;
  }
  .nav-btn:active {
    transform: scale(0.94);
  }
  .nav-btn:disabled {
    background: var(--bg);
    color: var(--muted);
    cursor: default;
  }

  .cur-btn {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 14px;
    background: var(--bg);
    border: 2px solid var(--border);
    border-radius: 14px;
    cursor: pointer;
    text-align: left;
  }
  .cur-btn:hover,
  .cur-btn[aria-expanded='true'] {
    border-color: var(--accent);
  }
  .cur-text {
    display: grid;
    min-width: 0;
  }
  .cur-text strong {
    font: 700 1.15rem var(--font-title);
  }
  .cur-text :global(.of) {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .cur-text :global(.ok) {
    margin-left: 6px;
    font-size: 0.8rem;
    color: #69f0ae;
  }
  .cur-text small {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .caret {
    flex: none;
    font-size: 1.1rem;
    color: var(--muted);
  }
  .menu {
    position: absolute;
    z-index: 25;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.5);
  }
  .menu input {
    width: 100%;
    padding: 8px 10px;
    font: inherit;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .menu ul {
    max-height: 320px;
    overflow-y: auto;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .menu :global(li[hidden]) {
    display: none;
  }
  .menu :global(li button) {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    background: none;
    border: 0;
    border-radius: 8px;
    text-align: left;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .menu :global(li button:hover),
  .menu :global(li button.on) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .menu :global(li button > span:last-child) {
    display: block;
  }
  .menu :global(li small) {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .menu :global(.num) {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bg);
    font-weight: 700;
    font-size: 0.8rem;
  }
  .menu :global(button.done .num) {
    background: #2e7d32;
    color: #fff;
  }
  .timeline {
    position: relative;
    height: 52px;
    margin: 6px 0 4px;
  }
  .rail {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 13px;
    height: 8px;
    border-radius: 4px;
    background: var(--bg);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #e86fd0, var(--accent));
  }
  .timeline :global(.tick) {
    position: absolute;
    top: 11px;
    width: 3px;
    height: 12px;
    border-radius: 2px;
    background: var(--border);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .timeline :global(.tick.done) {
    top: 9px;
    height: 16px;
    background: #4cc46b;
  }
  .timeline :global(.lvl-mark) {
    position: absolute;
    top: 30px;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    pointer-events: none;
  }
  @media (max-width: 600px) {
    .timeline :global(.x31) {
      display: none;
    }
  }
  .timeline input {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 34px;
    margin: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .timeline input::-webkit-slider-runnable-track {
    height: 34px;
    background: transparent;
  }
  .timeline input::-moz-range-track {
    background: transparent;
  }
  .timeline input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 28px;
    height: 28px;
    margin-top: 3px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.5);
  }
  .timeline input::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid #fff;
  }
  .timeline input:focus-visible::-webkit-slider-thumb {
    outline: 3px solid var(--text);
  }

  /* lienzo */
  .board {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 900px) {
    .board {
      grid-template-columns: 1fr 330px;
    }
  }
  .viewport {
    position: relative;
    height: min(62vh, 560px);
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--muted) 25%, transparent) 1px, transparent 1px) 0 0 / 22px 22px,
      var(--bg);
    touch-action: none;
    cursor: grab;
    user-select: none;
  }
  .viewport:active {
    cursor: grabbing;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }
  .world :global(.edges) {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  .world :global(path) {
    fill: none;
    stroke: color-mix(in srgb, var(--c) 45%, transparent);
    stroke-width: 3;
    transition: stroke 0.2s, opacity 0.2s;
  }
  .world :global(path.done) {
    stroke: #4cc46b;
  }
  .world:global(.focusing) :global(path:not(.hl)) {
    opacity: 0.35;
  }
  .world :global(path.hl) {
    stroke: var(--c);
    stroke-width: 6;
  }
  .world :global(.edge-item) {
    position: absolute;
    image-rendering: pixelated;
    pointer-events: none;
    opacity: 0.7;
  }
  .world :global(.edge-item.hl) {
    opacity: 1;
    transform: scale(1.4);
  }
  .world :global(.lvl) {
    position: absolute;
    left: -110px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .world :global(.node) {
    position: absolute;
    width: 160px;
    min-height: 140px;
    padding: 8px 4px;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 14px;
    cursor: pointer;
    transition: border-color 0.2s, opacity 0.2s, box-shadow 0.2s;
  }
  .world:global(.focusing) :global(.node:not(.hl)) {
    opacity: 0.5;
  }
  .world :global(.node.hl) {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 35%, transparent);
    opacity: 1;
  }
  .world :global(.node .dots i) {
    font-size: 0.66rem;
    padding: 1px 3px;
  }
  .world :global(.node .who) {
    font-size: 0.9rem;
  }
  .world :global(.node.g-F) {
    border-top: 5px solid #f06292;
  }
  .world :global(.node.g-M) {
    border-top: 5px solid #42a5f5;
  }
  .world :global(.node.done) {
    border-color: #4cc46b;
    background: color-mix(in srgb, #4cc46b 15%, var(--surface));
  }
  .world :global(.node.goal) {
    border-color: #ffd54f;
  }
  .world :global(.badge) {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .world :global(.node.done .badge) {
    background: #4cc46b;
  }
  .zoom {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: grid;
    gap: 4px;
  }
  .zoom button {
    width: 36px;
    height: 36px;
    font-size: 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
  }

  /* detalle del paso */
  .detail {
    padding: 12px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .detail :global(h3) {
    margin: 0 0 8px;
    font-size: 1rem;
  }
  .detail :global(.prep) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }
  .detail :global(.prep li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  :global(.mon) {
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
  }
  :global(.mon img) {
    pointer-events: none;
  }
  :global(.sid) {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
  }
  :global(.who) {
    font-size: 0.85rem;
  }
  :global(.g) {
    font-size: 1.15rem;
    font-family: system-ui, sans-serif;
  }
  :global(.g.m) {
    color: #42a5f5;
  }
  :global(.g.f) {
    color: #f06292;
  }
  :global(.g.n) {
    color: var(--muted);
  }
  :global(.dots) {
    display: flex;
    gap: 2px;
  }
  :global(.dots i) {
    font-style: normal;
    font-size: 0.55rem;
    font-weight: 700;
    padding: 1px 2px;
    border-radius: 4px;
    color: var(--muted);
    background: var(--bg);
  }
  :global(.dots i.on) {
    color: var(--ink);
    background: var(--c);
  }
  .detail :global(.pair) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  .detail :global(.pair > div) {
    display: grid;
    justify-items: center;
    gap: 4px;
  }
  .detail :global(.side) {
    padding: 1px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .detail :global(.side.f) {
    background: color-mix(in srgb, #f06292 25%, transparent);
    color: #f8a5c2;
  }
  .detail :global(.side.m) {
    background: color-mix(in srgb, #42a5f5 25%, transparent);
    color: #90caf9;
  }
  .detail :global(.x) {
    font: 700 1.3rem var(--font-title);
    color: var(--accent);
  }
  .detail :global(.held),
  .detail :global(.next) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .detail :global(.held img),
  .detail :global(.next img) {
    image-rendering: pixelated;
  }
  .detail :global(.arrow) {
    margin: 6px 0;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: #4cc46b;
  }
  .detail :global(.result) {
    display: grid;
    justify-items: center;
  }
  .detail :global(.note) {
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: #ffd54f;
  }
  .detail :global(.tick) {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 10px;
    padding: 10px;
    border-radius: 10px;
    background: var(--surface);
    font-weight: 700;
    cursor: pointer;
  }
  .detail :global(.tick input) {
    width: 22px;
    height: 22px;
    accent-color: #4cc46b;
  }
  .detail :global(.nav) {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
  }
  .detail :global(.nav button) {
    padding: 8px 12px;
    font-size: 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
  }

  .progress {
    height: 10px;
    margin-top: 14px;
    border-radius: 5px;
    background: var(--bg);
    overflow: hidden;
  }
  .progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #e86fd0, #4cc46b);
    transition: width 0.3s;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .actions button,
  .actions .btn {
    padding: 8px 14px;
    font-size: 0.9rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
  }
  .actions .ghost {
    color: var(--muted);
  }

  /* estrategia de género y resultado de los huevos al azar */
  .sub {
    margin: 14px 0 8px;
    font-size: 0.95rem;
  }
  .strat :global(.opt span) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  :global(.gs.x) {
    background: #5c6273;
    font-size: 0.8rem;
  }
  :global(.gs.n) {
    background: #3a3f4d;
  }
  #inv-note {
    display: grid;
    gap: 6px;
  }
  #inv-note :global(span) {
    display: flex;
    gap: 6px;
    align-items: flex-start;
  }
  .detail :global(.note.free) {
    color: #8ff0a4;
  }
  /* pregunta arriba y los dos botones en columnas fijas: no se mueve al elegir */
