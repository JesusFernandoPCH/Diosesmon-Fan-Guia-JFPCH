---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { artwork, sections } from '../data/sections';
---

<Base
  description="Guía en español de Cobblemon para el servidor Diosesmon: dónde aparece cada Pokémon, crianza 6x31 paso a paso, mapa del Safari, evoluciones, megas, interacciones y fusiones."
>
  <section class="intro">
    <h1 class="rise">Todo lo que necesitas para <span>Cobblemon</span> en Diosesmon</h1>
    <p class="rise" style="--i: 1">Información rápida, clara y directa. Elige una sección para empezar.</p>
  </section>

  <ul class="grid">
    {
      sections.map((s, i) => (
        <li class="rise" style={`--i: ${i + 2}`}>
          <a href={`/${s.slug}/`} class="card" style={`--c: ${s.color}`}>
            <Image src={artwork(s.art)} alt="" width={160} height={160} format="webp" loading={i < 2 ? 'eager' : 'lazy'} />
            <div>
              <h2>{s.title}</h2>
              <p>{s.desc}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    position: relative;
    margin: 8px 0 28px;
    padding: 28px 0 20px;
    isolation: isolate;
  }
  .intro h1 {
    max-width: 720px;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }
  .intro span {
    color: var(--accent);
  }
  .intro p {
    margin: 0;
    color: var(--muted);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(12, 1fr);
    }
    .grid li {
      grid-column: span 3;
    }
    /* las tres secciones principales, más grandes */
    .grid li:nth-child(-n + 3) {
      grid-column: span 4;
    }
    .grid li:nth-child(-n + 3) .card {
      padding: 24px;
      gap: 20px;
    }
    .grid li:nth-child(-n + 3) img {
      width: 112px;
      height: 112px;
    }
    .grid li:nth-child(-n + 3) h2 {
      font-size: 1.5rem;
    }
    .grid .card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .card {
    position: relative;
    overflow: hidden;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    text-decoration: none;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 14%, var(--surface)), var(--surface) 60%);
    border-radius: var(--radius);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow:
      var(--neu),
      0 0 0 2px var(--c);
  }
  .card:active {
    transform: none;
    box-shadow: var(--neu-in);
  }
  .card img {
    flex: none;
    width: 88px;
    height: 88px;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.45));
    transition: transform 0.25s;
  }
  .card:hover img {
    transform: scale(1.08) rotate(-3deg);
  }
  .card h2 {
    width: fit-content;
    font-size: 1.25rem;
    color: var(--c);
  }
  .card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
</style>
