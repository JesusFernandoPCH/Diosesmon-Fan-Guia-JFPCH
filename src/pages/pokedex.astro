---
import Base from '../layouts/Base.astro';
import TypeChip from '../components/TypeChip.astro';
import Icon from '../components/Icon.astro';
import biomeData from '../data/biomes.json';
import meta from '../data/meta.json';
import type { Biome, Pokemon } from '../data/types';
import { all } from '../lib/evo';
import { BUCKETS, CATEGORIES, EGG, PLACES, POSITIONS, TIMES, TYPES, label } from '../data/labels';

const pokemon = all;
const biomes = biomeData as Biome[];
const BUCKET_ORDER = Object.keys(BUCKETS);
const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

// Índice compacto para filtrar en el navegador.
// Cada spawn: [posición, rareza, nºconjunto de biomas, hora, clima, lugares[]]
const biomeSets: string[] = [];
const setIndex = (b: number[]) => {
  const key = b.join(',');
  let i = biomeSets.indexOf(key);
  if (i < 0) i = biomeSets.push(key) - 1;
  return i;
};
const index = pokemon.map((p) => {
  const spawns = new Map<string, unknown[]>();
  for (const s of p.spawns) {
    const weather = s.thunder ? 'thunder' : s.rain === true ? 'rain' : s.rain === false ? 'clear' : '';
    const row = [s.pos, s.alpha ? 'boss' : s.bucket, setIndex(s.biomes), s.time ?? '', weather, s.places ?? []];
    spawns.set(JSON.stringify(row), row);
  }
  return {
    id: p.id,
    n: fold(`${p.es} ${p.en}`),
    es: p.es,
    t: p.types,
    g: p.gen,
    e: p.egg,
    c: p.cats,
    br: !p.egg.includes('undiscovered') && !p.cats.includes('baby'),
    s: [...spawns.values()],
  };
});

const bestBucket = (p: Pokemon) =>
  p.spawns.map((s) => (s.alpha ? 'boss' : s.bucket)).sort((a, b) => BUCKET_ORDER.indexOf(a) - BUCKET_ORDER.indexOf(b))[0];
const usedPlaces = [...new Set(pokemon.flatMap((p) => p.spawns.flatMap((s) => s.places ?? [])))].sort((a, b) =>
  label(PLACES, a).localeCompare(label(PLACES, b), 'es'),
);
const gens = [...new Set(pokemon.map((p) => p.gen))].sort();
const DIMS = { overworld: 'Overworld', nether: 'Nether', end: 'End' };
const num = (id: number) => `#${String(id).padStart(4, '0')}`;
---

<Base breadcrumbs={[{ name: 'Pokédex y Spawns', path: '/pokedex/' }]} title="Pokédex y spawns: dónde aparece cada Pokémon en Cobblemon" description="Busca cualquier Pokémon de Cobblemon y filtra por bioma, rareza, tipo, generación, grupo huevo y forma de aparición.">
  <h1 class="rise">Pokédex y Spawns</h1>
  <p class="intro">Busca un Pokémon o usa los filtros para saber qué aparece en cada bioma, hora y clima.</p>

  <form id="filters" class="layout" autocomplete="off">
    <div class="topbar">
      <input type="search" name="q" placeholder="Buscar por nombre o número…" aria-label="Buscar Pokémon" />
      <button type="button" class="open-filters" data-toggle>Filtros <span data-active-count></span></button>
    </div>

    <aside class="panel" aria-label="Filtros">
      <div class="panel-head">
        <strong>Filtros</strong>
        <button type="reset" class="link">Limpiar todo</button>
      </div>

      <details open>
        <summary>Método de aparición</summary>
        <div class="opts">
          {
            Object.entries(POSITIONS).map(([k, [name, icon]]) => (
              <label class="opt">
                <input type="checkbox" name="pos" value={k} />
                <span>
                  <Icon name={icon} size={16} /> {name}
                </span>
              </label>
            ))
          }
        </div>
      </details>

      <details open>
        <summary>Bioma</summary>
        <select name="biome" aria-label="Bioma">
          <option value="">Cualquier bioma</option>
          {
            Object.entries(DIMS).map(([dim, name]) => (
              <optgroup label={name}>
                {biomes.map((b, i) => b.dim === dim && <option value={i} data-id={b.id}>{b.es}</option>)}
              </optgroup>
            ))
          }
        </select>
        <figure class="biome-preview" hidden>
          <img alt="" width="320" height="180" />
          <figcaption></figcaption>
        </figure>
      </details>

      <details open>
        <summary>Rareza</summary>
        <div class="opts">
          {
            Object.entries(BUCKETS).filter(([k]) => k in meta.world).map(([k, [name, color]]) => (
              <label class="opt" style={`--r: ${color}`}>
                <input type="checkbox" name="rarity" value={k} />
                <span class="rar">{name}</span>
              </label>
            ))
          }
        </div>
      </details>

      <details open>
        <summary>Hora y clima</summary>
        <p class="hint">Muestra lo que puede aparecer en ese momento.</p>
        <div class="opts">
          {
            Object.entries(TIMES).map(([k, name]) => (
              <label class="opt">
                <input type="radio" name="time" value={k} />
                <span>{name}</span>
              </label>
            ))
          }
        </div>
        <div class="opts">
          <label class="opt"><input type="radio" name="weather" value="clear" /><span><Icon name="sun" size={16} /> Despejado</span></label>
          <label class="opt"><input type="radio" name="weather" value="rain" /><span><Icon name="rain" size={16} /> Lluvia</span></label>
          <label class="opt"><input type="radio" name="weather" value="thunder" /><span><Icon name="storm" size={16} /> Tormenta</span></label>
        </div>
      </details>

      <details open>
        <summary>Tipo</summary>
        <p class="hint">Si eliges dos, muestra los que tienen ambos.</p>
        <div class="opts">
          {
            Object.entries(TYPES).map(([k, [name, color]]) => (
              <label class="opt type" style={`--t: ${color}`}>
                <input type="checkbox" name="type" value={k} />
                <span>{name}</span>
              </label>
            ))
          }
        </div>
      </details>

      <details open>
        <summary>Generación</summary>
        <div class="opts">
          {
            gens.map((g) => (
              <label class="opt">
                <input type="checkbox" name="gen" value={g} />
                <span>Gen {g}</span>
              </label>
            ))
          }
        </div>
      </details>

      <details>
        <summary>Lugar especial</summary>
        <select name="place" aria-label="Lugar especial">
          <option value="">Cualquier lugar</option>
          {usedPlaces.map((pl) => <option value={pl}>{label(PLACES, pl)}</option>)}
        </select>
      </details>

      <details>
        <summary>Grupo huevo</summary>
        <select name="egg" aria-label="Grupo huevo">
          <option value="">Cualquier grupo</option>
          {Object.entries(EGG).map(([k, name]) => <option value={k}>{name}</option>)}
        </select>
      </details>

      <details>
        <summary>Categoría</summary>
        <div class="opts">
          {
            Object.entries(CATEGORIES).map(([k, name]) => (
              <label class="opt">
                <input type="checkbox" name="cat" value={k} />
                <span>{name}</span>
              </label>
            ))
          }
        </div>
      </details>

      <details>
        <summary>Número de Pokédex</summary>
        <div class="range">
          <input type="number" name="min" min="1" placeholder="Desde" aria-label="Desde el número" />
          <span>–</span>
          <input type="number" name="max" min="1" placeholder="Hasta" aria-label="Hasta el número" />
        </div>
      </details>

      <details>
        <summary>Otros</summary>
        <div class="opts">
          <label class="opt"><input type="radio" name="wild" value="yes" /><span>Aparece salvaje</span></label>
          <label class="opt"><input type="radio" name="wild" value="no" /><span>No aparece salvaje</span></label>
          <label class="opt"><input type="checkbox" name="breed" value="1" /><span><Icon name="egg" size={16} /> Puede criar</span></label>
        </div>
      </details>

      <button type="button" class="show-results" data-toggle>Ver <span data-count></span> resultados</button>
    </aside>

    <section class="results">
      <div class="results-bar">
        <span><strong data-count></strong> Pokémon</span>
        <label>
          Ordenar:
          <select name="sort">
            <option value="num">Nº Pokédex</option>
            <option value="name">Nombre (A-Z)</option>
          </select>
        </label>
      </div>

      <ul class="grid" id="list">
        {
          pokemon.map((p, i) => {
            const best = bestBucket(p);
            const methods = [...new Set(p.spawns.map((s) => s.pos))];
            return (
              <li data-i={i}>
                <a href={`/pokemon/${p.slug}/`} class="card">
                  <img src={`/img/thumb/${p.id}.webp`} alt="" width="72" height="72" loading="lazy" data-vt={`mon-${p.id}`} />
                  <span class="num">{num(p.id)}</span>
                  <span class="name">{p.es}</span>
                  <span class="types">
                    {p.types.map((t) => (
                      <TypeChip type={t} small />
                    ))}
                  </span>
                  <span class="meta">
                    {best ? (
                      <span class="rar" style={`--r: ${BUCKETS[best][1]}`}>
                        {BUCKETS[best][0]}
                      </span>
                    ) : (
                      <span class="nowild">No salvaje</span>
                    )}
                    <span class="icons" title={methods.map((m) => POSITIONS[m][0]).join(', ')}>
                      {methods.map((m) => (
                        <Icon name={POSITIONS[m][1]} size={15} />
                      ))}
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="empty" id="empty" hidden>Ningún Pokémon coincide con estos filtros. Prueba quitando alguno.</p>
    </section>
  </form>

  <script is:inline type="application/json" id="index" set:html={JSON.stringify({ index, biomeSets })} />
</Base>

<script>
  type Row = [string, string, number, string, string, string[]];
  type Entry = { id: number; n: string; es: string; t: string[]; g: number; e: string[]; c: string[]; br: boolean; s: Row[] };

  const { index, biomeSets } = JSON.parse(document.getElementById('index')!.textContent!) as {
    index: Entry[];
    biomeSets: string[];
  };
  const sets = biomeSets.map((s) => new Set(s.split(',').map(Number)));
  const form = document.getElementById('filters') as HTMLFormElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#list > li')];
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
  const nameRank: number[] = [];
  index
    .map((_, i) => i)
    .sort((a, b) => index[a].es.localeCompare(index[b].es, 'es'))
    .forEach((i, rank) => (nameRank[i] = rank));

  // Hora/clima: "puede aparecer ahora" → acepta spawns sin restricción
  const okTime = (want: string, has: string) => !want || !has || has === want;
  const okWeather = (want: string, has: string) =>
    !want || !has || (want === 'clear' ? has === 'clear' : want === 'rain' ? has === 'rain' : has !== 'clear');

  function apply() {
    const f = new FormData(form);
    const all = (k: string) => f.getAll(k) as string[];
    const one = (k: string) => (f.get(k) as string) ?? '';
    const q = fold(one('q')).replace(/^#0*/, '');
    const [types, gens, rarity, pos, cats] = ['type', 'gen', 'rarity', 'pos', 'cat'].map(all);
    const [biome, time, weather, place, egg, wild, min, max] = ['biome', 'time', 'weather', 'place', 'egg', 'wild', 'min', 'max'].map(one);
    const breed = f.has('breed');
    const spawnFilter = rarity.length || pos.length || biome || time || weather || place;

    const rowOk = ([p, b, set, t, w, places]: Row) =>
      (!rarity.length || rarity.includes(b)) &&
      (!pos.length || pos.includes(p)) &&
      (!biome || sets[set].has(+biome)) &&
      okTime(time, t) &&
      okWeather(weather, w) &&
      (!place || places.includes(place));

    let shown = 0;
    index.forEach((e, i) => {
      const ok =
        (!q || (/^\d+$/.test(q) ? String(e.id) === q : e.n.includes(q))) &&
        (!min || e.id >= +min) &&
        (!max || e.id <= +max) &&
        (!gens.length || gens.includes(String(e.g))) &&
        types.every((t) => e.t.includes(t)) &&
        (!egg || e.e.includes(egg)) &&
        (!cats.length || cats.some((c) => e.c.includes(c))) &&
        (!breed || e.br) &&
        (wild !== 'yes' || e.s.length > 0) &&
        (wild !== 'no' || e.s.length === 0) &&
        (!spawnFilter || e.s.some(rowOk));
      items[i].hidden = !ok;
      if (ok) shown++;
    });

    // Imagen del bioma elegido
    const preview = form.querySelector<HTMLElement>('.biome-preview')!;
    preview.hidden = !biome;
    if (biome) {
      const opt = form.querySelector<HTMLOptionElement>(`select[name=biome] option[value="${biome}"]`)!;
      preview.querySelector('img')!.src = `/img/biome/${opt.dataset.id}.webp`;
      preview.querySelector('figcaption')!.textContent = opt.textContent;
    }

    const sort = one('sort');
    items.forEach((li, i) => (li.style.order = sort === 'name' ? String(nameRank[i]) : ''));
    document.querySelectorAll('[data-count]').forEach((el) => (el.textContent = String(shown)));
    document.getElementById('empty')!.hidden = shown > 0;

    // Guarda los filtros en la URL para poder compartir el enlace
    const params = new URLSearchParams();
    for (const [k, v] of f) if (v && !(k === 'sort' && v === 'num')) params.append(k, v as string);
    const active = [...params.keys()].filter((k) => k !== 'q' && k !== 'sort').length;
    document.querySelector('[data-active-count]')!.textContent = active ? `(${active})` : '';
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  }

  // Restaura filtros desde la URL
  for (const [k, v] of new URLSearchParams(location.search)) {
    for (const el of form.elements.namedItem(k) instanceof RadioNodeList
      ? [...(form.elements.namedItem(k) as RadioNodeList)]
      : [form.elements.namedItem(k)]) {
      if (!el) continue;
      const input = el as HTMLInputElement;
      if (input.type === 'checkbox' || input.type === 'radio') input.checked ||= input.value === v;
      else input.value = v;
    }
  }

  form.addEventListener('input', apply);
  form.addEventListener('reset', () => setTimeout(apply));
  form.addEventListener('submit', (e) => e.preventDefault());
  // Permite desmarcar un radio volviendo a hacer clic
  form.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => {
    r.addEventListener('mousedown', () => (r.dataset.was = String(r.checked)));
    r.addEventListener('click', () => {
      if (r.dataset.was === 'true') {
        r.checked = false;
        apply();
      }
    });
  });
  document.querySelectorAll('[data-toggle]').forEach((b) =>
    b.addEventListener('click', () => document.body.classList.toggle('filters-open')),
  );
  apply();
</script>

<style>
  .intro {
    color: var(--muted);
    margin-top: 0;
  }
  .layout {
    display: grid;
    gap: 16px;
  }
  .topbar {
    display: flex;
    gap: 8px;
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    padding: 8px 0;
    background: var(--bg);
  }
  input,
  select,
  button {
    font: inherit;
    color: inherit;
  }
  input[type='search'],
  input[type='number'],
  select {
    width: 100%;
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  input[type='search'] {
    font-size: 1.05rem;
  }
  .open-filters,
  .show-results {
    flex: none;
    padding: 10px 16px;
    border: 0;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .link {
    border: 0;
    background: none;
    color: var(--accent);
    cursor: pointer;
  }

  /* Panel de filtros: hoja a pantalla completa en móvil, barra lateral en escritorio */
  .panel {
    display: none;
  }
  :global(body.filters-open) .panel {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow-y: auto;
    padding: 16px 16px 80px;
    background: var(--bg);
  }
  .show-results {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    font: 600 1.2rem var(--font-title);
  }
  .panel details {
    border-top: 1px solid var(--border);
    padding: 10px 0;
  }
  .panel summary {
    cursor: pointer;
    font-weight: 600;
  }
  .hint {
    margin: 4px 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .opt {
    position: relative;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opt span {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    cursor: pointer;
    user-select: none;
  }
  .opt input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .opt input:focus-visible + span {
    outline: 2px solid var(--text);
  }
  .opt.type input:checked + span {
    background: var(--t);
    border-color: var(--t);
  }
  .opt .rar {
    color: var(--r);
  }
  .opt input:checked + .rar {
    background: var(--r);
    border-color: var(--r);
    color: #111;
  }
  .biome-preview {
    margin: 8px 0 0;
  }
  .biome-preview img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
  }
  .biome-preview figcaption {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .range {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 8px;
  }
  select {
    margin-top: 8px;
  }

  .results-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: var(--muted);
  }
  .results-bar select {
    width: auto;
    margin: 0 0 0 6px;
    padding: 6px 8px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .card {
    height: 100%;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 10px 8px;
    text-align: center;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card img {
    width: 72px;
    height: 72px;
  }
  .num {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .name {
    font: 600 1rem var(--font-title);
  }
  .types {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .meta {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 4px;
    font-size: 0.75rem;
  }
  .meta .rar {
    color: var(--r);
    font-weight: 600;
  }
  .nowild {
    color: var(--muted);
  }
  .empty {
    padding: 20px;
    text-align: center;
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 270px 1fr;
      align-items: start;
    }
    .topbar {
      grid-column: 1 / -1;
    }
    .open-filters,
    .show-results {
      display: none;
    }
    .panel {
      display: block;
      position: sticky;
      top: 120px;
      max-height: calc(100dvh - 130px);
      overflow-y: auto;
      padding-right: 8px;
    }
  }
</style>
