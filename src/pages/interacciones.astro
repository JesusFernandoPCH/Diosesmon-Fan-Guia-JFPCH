---
import Base from '../layouts/Base.astro';
import InteractionWay from '../components/InteractionWay.astro';
import ItemChip from '../components/ItemChip.astro';
import data from '../data/interactions.json';
import itemData from '../data/items.json';
import type { Interaction, Item } from '../data/types';
import { bySlug } from '../lib/evo';

const items = itemData as Record<string, Item>;
const list = (data as Interaction[]).filter((i) => bySlug.has(i.slug));
const slugs = [...new Set(list.map((i) => i.slug))].sort((a, b) => bySlug.get(a)!.id - bySlug.get(b)!.id);
const tools = [...new Set(list.map((i) => i.tool))];
const results = [...new Set(list.map((i) => i.item))].sort((a, b) => items[a].es.localeCompare(items[b].es));
const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
---

<Base breadcrumbs={[{ name: 'Interacciones', path: '/interacciones/' }]} title="Interacciones: qué te da cada Pokémon con brocha, cubo y más" description="Qué objeto usar sobre cada Pokémon en Cobblemon (brocha, harina de huesos, cubo…), qué te da y cada cuánto se puede repetir.">
  <h1 data-vt="sec-interacciones" data-vt-hero>Interacciones</h1>
  <p class="intro">
    Algunos Pokémon te dan objetos si los usas con algo en la mano. {list.length} interacciones en {slugs.length} Pokémon.
  </p>

  <details class="howto" open>
    <summary>¿Cómo funciona?</summary>
    <ol>
      <li>Saca a <strong>tu</strong> Pokémon de su Poké Ball.</li>
      <li>Con el objeto en la mano, haz <strong>clic derecho</strong> sobre él.</li>
      <li>Recibes el objeto: cae al suelo, o en el caso de cubos y botellas se llenan en tu mano.</li>
      <li>Espera el tiempo indicado (⏱️) antes de repetirlo con el mismo Pokémon.</li>
    </ol>
    <p class="legend">
      <ItemChip id="minecraft:brush" /> gasta durabilidad · <ItemChip id="minecraft:bone_meal" /> se gasta 1 ·
      <ItemChip id="minecraft:shears" /> esquila; la lana vuelve a crecer con el tiempo
    </p>
  </details>

  <form id="int-filters" class="filters" autocomplete="off">
    <input type="search" name="q" placeholder="Buscar Pokémon u objeto…" aria-label="Buscar Pokémon u objeto" />
    <div class="row">
      <div class="opts" role="radiogroup" aria-label="Objeto en la mano">
        <label class="opt"><input type="radio" name="tool" value="" checked /><span>Todos</span></label>
        {
          tools.map((t) => (
            <label class="opt">
              <input type="radio" name="tool" value={t} />
              <span>
                <img src={items[t].icon} alt="" width="18" height="18" />
                {items[t].es}
              </span>
            </label>
          ))
        }
      </div>
      <select name="item" aria-label="Qué quieres conseguir">
        <option value="">¿Qué quieres conseguir?</option>
        {results.map((r) => <option value={r}>{items[r].es}</option>)}
      </select>
      <label class="check"><input type="checkbox" name="free" /> Solo sin espera</label>
    </div>
  </form>
  <p class="count"><strong id="int-count">{slugs.length}</strong> Pokémon</p>

  <ul class="grid" id="int-list">
    {
      slugs.map((slug) => {
        const p = bySlug.get(slug)!;
        return (
          <li class="card" data-name={fold(`${p.es} ${p.en} ${p.id}`)}>
            <a class="mon" href={`/pokemon/${slug}/`}>
              <img src={`/img/thumb/${p.id}.webp`} alt="" width="56" height="56" loading="lazy" />
              <span>
                <span class="num">#{String(p.id).padStart(3, '0')}</span>
                <strong>{p.es}</strong>
              </span>
            </a>
            {list
              .filter((i) => i.slug === slug)
              .map((i) => (
                <div class="w" data-tool={i.tool} data-item={i.item} data-cd={i.cd} data-text={fold(`${items[i.item].es} ${items[i.tool].es}`)}>
                  <InteractionWay i={i} />
                </div>
              ))}
          </li>
        );
      })
    }
  </ul>
  <p id="int-empty" class="empty" hidden>Ninguna interacción coincide.</p>
</Base>

<script>
  const form = document.getElementById('int-filters') as HTMLFormElement;
  const cards = [...document.querySelectorAll<HTMLLIElement>('#int-list > li')];
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  function apply() {
    const f = new FormData(form);
    const q = fold(String(f.get('q') ?? '')).replace(/^#0*/, '');
    const tool = String(f.get('tool') ?? '');
    const item = String(f.get('item') ?? '');
    const free = f.has('free');
    let shown = 0;
    for (const li of cards) {
      const nameHit = !q || li.dataset.name!.includes(q);
      let any = false;
      for (const w of li.querySelectorAll<HTMLElement>('.w')) {
        const ok =
          (nameHit || w.dataset.text!.includes(q)) &&
          (!tool || w.dataset.tool === tool) &&
          (!item || w.dataset.item === item) &&
          (!free || w.dataset.cd === '0');
        w.hidden = !ok;
        any ||= ok;
      }
      li.hidden = !any;
      if (any) shown++;
    }
    document.getElementById('int-count')!.textContent = String(shown);
    document.getElementById('int-empty')!.hidden = shown > 0;
    const params = new URLSearchParams();
    for (const [k, v] of f) if (v) params.set(k, String(v));
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
  }

  const params = new URLSearchParams(location.search);
  for (const el of form.elements as unknown as Iterable<HTMLInputElement>) {
    if (!el.name) continue;
    const v = params.get(el.name);
    if (el.type === 'radio') el.checked = el.value === (v ?? '');
    else if (el.type === 'checkbox') el.checked = !!v;
    else if (v) el.value = v;
  }
  form.addEventListener('input', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
  apply();
</script>

<style>
  .intro {
    color: var(--muted);
    margin-top: 0;
  }
  .howto {
    margin-bottom: 16px;
    padding: 12px 16px;
    background: linear-gradient(135deg, color-mix(in srgb, #4cc46b 18%, var(--surface)), var(--surface) 60%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .howto summary {
    cursor: pointer;
    font: 600 1.05rem var(--font-title);
  }
  .howto ol {
    margin: 10px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }
  .legend {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 2;
  }
  .filters {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding: 8px 0;
    background: var(--bg);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  input[type='search'],
  select {
    padding: 10px 12px;
    font: inherit;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  input[type='search'] {
    width: 100%;
    font-size: 1.05rem;
  }
  .opts {
    display: flex;
    gap: 6px;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .opt {
    position: relative;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .opt span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .opt img {
    image-rendering: pixelated;
  }
  .opt input:checked + span {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .opt input:focus-visible + span {
    outline: 2px solid var(--text);
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .count {
    color: var(--muted);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .card {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 12px 14px;
    background: color-mix(in srgb, var(--surface) 50%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .grid > [hidden],
  .w[hidden] {
    display: none;
  }
  .w + .w {
    padding-top: 10px;
    border-top: 1px dashed var(--border);
  }
  .mon {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }
  .mon > span {
    display: grid;
  }
  .num {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .empty {
    padding: 20px;
    text-align: center;
    color: var(--muted);
  }
</style>
