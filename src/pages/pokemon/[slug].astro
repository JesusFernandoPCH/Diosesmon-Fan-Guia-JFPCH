---
import Base from '../../layouts/Base.astro';
import TypeChip from '../../components/TypeChip.astro';
import BiomeList from '../../components/BiomeList.astro';
import MoonChip from '../../components/MoonChip.astro';
import PlaceChip from '../../components/PlaceChip.astro';
import Tip from '../../components/Tip.astro';
import ItemChip from '../../components/ItemChip.astro';
import Icon from '../../components/Icon.astro';
import EvoTree from '../../components/EvoTree.astro';
import MegaCard from '../../components/MegaCard.astro';
import FusionCard from '../../components/FusionCard.astro';
import { FUSIONS } from '../../data/fusions';
import InteractionWay from '../../components/InteractionWay.astro';
import interactionData from '../../data/interactions.json';
import { all, bySlug, familyMembers, rootOf } from '../../lib/evo';
import { megas as availableMegas } from '../../data/obtain';
import blocks from '../../data/blocks.json';
import meta from '../../data/meta.json';
import baitData from '../../data/baits.json';
import type { Interaction, Pokemon, Spawn } from '../../data/types';
import { BLOCK_TAGS, BUCKETS, CATEGORIES, EGG, FORMS, POSITIONS, TIMES, TYPES, ZONES, label } from '../../data/labels';

export function getStaticPaths() {
  return all.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: all[i - 1], next: all[i + 1] } }));
}

const { p, prev, next } = Astro.props as { p: Pokemon; prev?: Pokemon; next?: Pokemon };
const num = (id: number) => `#${String(id).padStart(4, '0')}`;
const BUCKET_ORDER = Object.keys(BUCKETS);
const blockName = (b: string) => (blocks as Record<string, string>)[b] ?? label(BLOCK_TAGS, b);

// Condiciones de un spawn como lista de textos cortos
function conditions(s: Spawn) {
  const out: string[] = [];
  const form = s.form?.split(' ').map((t) => FORMS[t]).filter(Boolean).join(', ');
  if (form) out.push(form);
  if (s.alpha) out.push('Líder alfa');
  else if (s.herd) out.push(s.bucket === 'boss' ? 'En la manada de un alfa' : 'En manada');
  if (s.time) out.push(TIMES[s.time] ?? s.time);
  if (s.thunder) out.push('Con tormenta');
  else if (s.rain === true) out.push('Con lluvia');
  else if (s.rain === false) out.push('Sin lluvia');
  if (s.sky === true) out.push('Cielo abierto');
  if (s.sky === false) out.push('Bajo techo o cueva');
  if (s.minY !== undefined && s.maxY !== undefined) out.push(`Altura Y ${s.minY} a ${s.maxY}`);
  else if (s.minY !== undefined) out.push(`Altura Y ≥ ${s.minY}`);
  else if (s.maxY !== undefined) out.push(`Altura Y ≤ ${s.maxY}`);
  if (s.nearby) out.push(`Cerca de: ${[...new Set(s.nearby.map(blockName))].join(', ')}`);
  if (s.snack) out.push('Solo con Poké Snack');
  if (s.slime) out.push('Chunk de slime');
  return out;
}

// Atracción que pide la pesca: rango [mínimo, máximo] (el encantamiento llega a nivel 3)
function lureInfo(s: Spawn): [string, string] {
  const lo = s.lure ?? 0, hi = s.lureMax ?? 3;
  const how = 'Se encanta en la mesa de encantamientos, o con un libro encantado en el yunque.';
  if (hi === 0) return ['Caña sin Atracción', 'Solo sale si tu Poké Caña NO tiene el encantamiento Atracción.'];
  if (lo === 0) return [`Caña con Atracción ${hi} como máximo`, `Sale con la caña sin Atracción o con Atracción hasta nivel ${hi}. Con más nivel ya no sale.`];
  if (lo === hi) return [`Caña con Atracción ${lo}`, `Tu Poké Caña necesita el encantamiento Atracción de nivel ${lo} exacto (ni más ni menos). ${how}`];
  if (hi === 3) return [`Caña con Atracción ${lo}+`, `Tu Poké Caña necesita el encantamiento Atracción de nivel ${lo} o más. ${how}`];
  return [`Caña con Atracción ${lo} a ${hi}`, `Tu Poké Caña necesita Atracción de nivel ${lo} a ${hi}. ${how}`];
}

// Cebos (bayas) que favorecen a este Pokémon al pescar: por tipo, por grupo huevo o por los EV que da. Salen todos, no solo uno.
const STATS: Record<string, string> = { hp: 'PS', atk: 'Ataque', def: 'Defensa', spa: 'At. Esp.', spd: 'Def. Esp.', spe: 'Velocidad' };
const baitWhy = new Map<string, { kind: number; why: string[] }>();
for (const [item, effects] of Object.entries(baitData as Record<string, { t: string; k: string }[]>)) {
  for (const e of effects) {
    let kind = -1, why = '';
    if (e.t === 'type' && p.types.includes(e.k)) [kind, why] = [0, TYPES[e.k]?.[0] ?? e.k];
    else if (e.t === 'egg' && p.egg.includes(e.k)) [kind, why] = [1, EGG[e.k] ?? e.k];
    else if (e.t === 'ev' && p.ev?.includes(e.k)) [kind, why] = [2, STATS[e.k] ?? e.k];
    if (kind < 0) continue;
    const cur = baitWhy.get(item) ?? { kind, why: [] };
    cur.kind = Math.min(cur.kind, kind);
    cur.why.push(why);
    baitWhy.set(item, cur);
  }
}
const BAIT_TEXT = ['Tipo', 'Grupo huevo', 'Da EV de'];
const baits = [...baitWhy].sort((a, b) => a[1].kind - b[1].kind);

// Une spawns que se ven iguales (solo cambian peso, nivel o variantes cosméticas)
const rows = new Map<string, { s: Spawn; conds: string[] }>();
for (const s of p.spawns) {
  const conds = conditions(s);
  const key = JSON.stringify([s.pos, s.alpha ? 'boss' : s.bucket, s.zones, s.except, s.biomes, conds, s.moon, s.places, s.lure, s.lureMax]);
  const prevRow = rows.get(key);
  if (!prevRow || prevRow.s.w < s.w) rows.set(key, { s, conds });
}
const groups = Object.entries(POSITIONS)
  .map(([pos, [name, icon, help]]) => ({
    pos,
    name,
    icon,
    help,
    rows: [...rows.values()]
      .filter((r) => r.s.pos === pos)
      .sort((a, b) => BUCKET_ORDER.indexOf(a.s.bucket) - BUCKET_ORDER.indexOf(b.s.bucket) || b.s.w - a.s.w),
  }))
  .filter((g) => g.rows.length);

// Rarezas de la pesca de este Pokémon y qué encantamiento las toca (Cobblemon 1.7.3):
// - Atracción solo desbloquea/limita Pokémon (cada spawn pide un rango de nivel) y acelera la mordida.
// - Suerte del mar suma niveles a un "nivel de rareza"; cada nivel aplana los pesos de las rarezas (peso^(1/(1.29+0.2·(nivel-1)))).
const fishRows = [...rows.values()].filter((r) => r.s.pos === 'fishing');
const fishBuckets = [...new Set(fishRows.map((r) => r.s.bucket))].sort((x, y) => BUCKET_ORDER.indexOf(x) - BUCKET_ORDER.indexOf(y));
const lureLevels = [0, 1, 2, 3].map((l) => ({
  l,
  buckets: fishBuckets.filter((b) => fishRows.some((r) => r.s.bucket === b && (r.s.lure ?? 0) <= l && l <= (r.s.lureMax ?? 3))),
}));
const lureMatters = lureLevels.some((x) => x.buckets.join() !== lureLevels[0].buckets.join());
const world = meta.world as Record<string, number>;
const rarityOdds = (tier: number, bucket: string) => {
  const f = 1.29 + 0.2 * (tier - 1);
  const w = Object.fromEntries(Object.entries(world).map(([k, v]) => [k, tier ? v ** (1 / f) : v]));
  return (w[bucket] / Object.values(w).reduce((x, y) => x + y, 0)) * 100;
};
const oddsText = (n: number) => `${n >= 10 ? Math.round(n) : n >= 1 ? n.toFixed(1) : n.toFixed(2)}%`;
const LEVEL_NAME = ['Sin encantar', 'I', 'II', 'III'];

const mainColor = TYPES[p.types[0]]?.[1] ?? '#777';
const canBreed = !p.egg.includes('undiscovered') && !p.cats.includes('baby');
const pct = (n: number) => `${Math.round(n * 1000) / 10}%`;
const family = familyMembers(rootOf(p.slug));
const megas = availableMegas.filter((m) => m.slug === p.slug);
const biomeCount = new Set(p.spawns.flatMap((s) => s.biomes)).size;
const metaDesc = `${p.es} (#${p.id}, tipo ${p.types.map((t) => TYPES[t]?.[0] ?? t).join('/')}) en Cobblemon: ${
  p.spawns.length ? `aparece en ${biomeCount} biomas, con su rareza, horario y condiciones` : 'no aparece salvaje'
}; evoluciones${megas.length ? ', megaevolución' : ''} y grupo huevo para criar en Diosesmon.`;
const fusions = FUSIONS.filter((f) => (f.a === p.slug || f.b === p.slug) && bySlug.has(f.a) && bySlug.has(f.b));
const interactions = (interactionData as Interaction[]).filter((i) => i.slug === p.slug);
---

<Base
  title={`${p.es}: dónde aparece, evoluciones y crianza`}
  description={metaDesc}
  image={`/img/art/${p.id}.webp`}
  breadcrumbs={[{ name: 'Pokédex', path: '/pokedex/' }, { name: p.es, path: `/pokemon/${p.slug}/` }]}
>
  <nav class="crumbs" aria-label="Navegación de la Pokédex">
    <a href="/pokedex/" class="btn back"><Icon name="left" /> Pokédex</a>
    <span class="step">
      {prev ? <a href={`/pokemon/${prev.slug}/`} class="btn icon" rel="prev" aria-label={`Anterior: ${prev.es}`} title={`${num(prev.id)} ${prev.es}`}><Icon name="left" /></a> : <span class="btn icon off" aria-hidden="true"><Icon name="left" /></span>}
      <b>{num(p.id)}</b>
      {next ? <a href={`/pokemon/${next.slug}/`} class="btn icon" rel="next" aria-label={`Siguiente: ${next.es}`} title={`${num(next.id)} ${next.es}`}><Icon name="right" /></a> : <span class="btn icon off" aria-hidden="true"><Icon name="right" /></span>}
    </span>
  </nav>

  <section class="hero" style={`--c: ${mainColor}`}>
    <img src={`/img/art/${p.id}.webp`} alt={`${p.es}, ilustración oficial`} width="320" height="320" data-vt={`mon-${p.id}`} data-vt-hero />
    <div>
      <p class="num">{num(p.id)} · Generación {p.gen}</p>
      <h1>{p.es}</h1>
      {p.en !== p.es && <p class="en">{p.en}</p>}
      <div class="chips">{p.types.map((t) => <TypeChip type={t} />)}</div>
      {
        p.cats.length > 0 && (
          <div class="chips">
            {p.cats.map((c) => (
              <span class="tag">{CATEGORIES[c]}</span>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="facts">
    <div class="fact">
      <h2>Grupo huevo</h2>
      <p>{p.egg.map((e) => EGG[e] ?? e).join(' · ')}</p>
      <small><Icon name={canBreed ? 'check' : 'close'} size={15} /> {canBreed ? 'Puede criar' : 'No puede criar'}</small>
    </div>
    <div class="fact">
      <h2>Género</h2>
      {
        p.male < 0 ? (
          <p>Sin género</p>
        ) : (
          <>
            <div class="gender" style={`--m: ${p.male * 100}%`} aria-hidden="true" />
            <p>
              <span class="male">Macho {pct(p.male)}</span> · <span class="female">Hembra {pct(1 - p.male)}</span>
            </p>
          </>
        )
      }
    </div>
    <div class="fact">
      <h2>Ratio de captura</h2>
      <p>{p.catchRate} <small>/ 255</small></p>
      <small>{p.catchRate >= 150 ? 'Fácil' : p.catchRate >= 60 ? 'Normal' : p.catchRate >= 25 ? 'Difícil' : 'Muy difícil'} de capturar</small>
    </div>
  </section>

  {
    family.length > 1 && (
      <section class="evo">
        <h2 class="section-title">Evoluciones</h2>
        <EvoTree slug={family[0]} current={p.slug} />
      </section>
    )
  }

  {
    megas.length > 0 && (
      <section class="evo">
        <h2 class="section-title">Mega Evolución</h2>
        <div class="megas">
          {megas.map((m) => (
            <MegaCard m={m} />
          ))}
        </div>
        <p class="more"><a href="/megas/">Cómo mega evolucionar <Icon name="right" /></a></p>
      </section>
    )
  }

  {
    fusions.length > 0 && (
      <section class="evo">
        <h2 class="section-title">Fusiones</h2>
        <div class="megas">
          {fusions.map((f) => (
            <FusionCard f={f} />
          ))}
        </div>
        <p class="more"><a href="/fusiones/">Cómo fusionar <Icon name="right" /></a></p>
      </section>
    )
  }

  {
    interactions.length > 0 && (
      <section class="evo">
        <h2 class="section-title">Interacciones</h2>
        <div class="ints">
          {interactions.map((i) => (
            <InteractionWay i={i} />
          ))}
        </div>
        <p class="more"><a href="/interacciones/">Cómo funcionan las interacciones <Icon name="right" /></a></p>
      </section>
    )
  }

  <section>
    <h2 class="section-title">Dónde aparece</h2>
    {
      groups.length === 0 ? (
        <p class="empty">
          {p.es} no aparece en estado salvaje. Se obtiene por evolución, crianza, eventos u otros métodos del servidor.
        </p>
      ) : (
        groups.map((g) => (
          <details class="group" open>
            <summary>
              <span class="icon"><Icon name={g.icon} size={20} /></span> {g.name} <span class="count">{g.rows.length}</span>
              <small>{g.help}</small>
            </summary>
            {g.pos === 'fishing' && (
              <div class="baits ench">
                <strong class="baits-title"><Icon name="fish" size={16} /> Encantamientos de la caña</strong>
                <div class="ench-grid">
                  <section>
                    <h4>Atracción</h4>
                    <p>
                      Hace que piquen antes y es la que <strong>desbloquea</strong> a algunos Pokémon (cada uno pide un nivel). No
                      cambia qué tan raro es el pique.
                    </p>
                    {lureMatters ? (
                      <div class="lv">
                        {lureLevels.map(({ l, buckets }) => (
                          <div>
                            <span class="lv-name">{l ? `Atracción ${LEVEL_NAME[l]}` : "Sin Atracción"}</span>
                            {buckets.length ? buckets.map((b) => <span class="rarity" style={`--r: ${BUCKETS[b][1]}`}>{BUCKETS[b][0]}</span>) : <span class="none">No sale</span>}
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p class="ok">{p.es} sale con cualquier nivel de Atracción, incluso con la caña sin encantar.</p>
                    )}
                  </section>
                  <section>
                    <h4>Suerte del mar</h4>
                    <p>
                      Es la que sube la <strong>rareza</strong> del pique: más nivel, más probabilidad de poco común, raro y muy
                      raro. Probabilidad de que el pique sea de la rareza de {p.es}:
                    </p>
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">Rareza</th>
                          {LEVEL_NAME.map((n) => <th scope="col">{n}</th>)}
                        </tr>
                      </thead>
                      <tbody>
                        {fishBuckets.map((b) => (
                          <tr>
                            <th scope="row"><span class="rarity" style={`--r: ${BUCKETS[b][1]}`}>{BUCKETS[b][0]}</span></th>
                            {[0, 1, 2, 3].map((t) => <td>{oddsText(rarityOdds(t, b))}</td>)}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </section>
                </div>
                <small>
                  Cada nivel de Suerte del mar suma 1 al nivel de rareza. Como cebo, la manzana dorada, el melón reluciente y la
                  zanahoria dorada suman +1 (y la manzana dorada encantada +10), pero ocupan el lugar de la baya. Cifras con
                  las rarezas base del servidor.
                </small>
              </div>
            )}
            {g.pos === 'fishing' && baits.length > 0 && (
              <div class="baits">
                <strong class="baits-title"><Icon name="fish" size={16} /> Cebos que lo atraen más</strong>
                <p>
                  Usa una baya como cebo en tu Poké Caña. Sirve <strong>cualquiera</strong> de estas, no solo una:
                </p>
                <ul>
                  {baits.map(([item, b]) => (
                    <li>
                      <ItemChip id={item} hint="Úsala como cebo en tu Poké Caña." />
                      <span class="why">{BAIT_TEXT[b.kind]} {b.why.join(' y ')}{b.kind < 2 ? ' · ×10' : ''}</span>
                    </li>
                  ))}
                </ul>
                <small>
                  Por tipo o grupo huevo, el cebo multiplica ×10 las probabilidades de este Pokémon frente a los demás de su
                  misma rareza. Con una baya de EV solo pican Pokémon que dan ese EV.
                </small>
              </div>
            )}
            <ul class="spawns">
              {g.rows.map(({ s, conds }) => {
                const [bName, bColor] = s.alpha ? ['Alfa', BUCKETS.boss[1]] : BUCKETS[s.bucket];
                return (
                  <li class="spawn">
                    <div class="spawn-head">
                      <span class="rarity" style={`--r: ${bColor}`}>{bName}</span>
                      {s.lvl && <span class="lvl">Nv. {s.lvl.replace('-', '–')}</span>}
                      <span class="weight" title="Peso: a mayor peso, más probable dentro de su rareza">peso {s.w}</span>
                    </div>
                    <div class="zones">
                      <BiomeList biomes={s.biomes} zones={s.zones} />
                      {s.except && <span class="except">Excepto: {s.except.map((z) => label(ZONES, z)).join(', ')}</span>}
                    </div>
                    {(conds.length > 0 || s.moon || s.places || s.lure || s.lureMax !== undefined) && (
                      <ul class="conds">
                        {conds.map((c) => (
                          <li>{c}</li>
                        ))}
                        {s.moon && (
                          <li>
                            <MoonChip value={s.moon} />
                          </li>
                        )}
                        {s.places?.map((pl) => (
                          <li>
                            <PlaceChip place={pl} />
                          </li>
                        ))}
                        {(s.lure || s.lureMax !== undefined) && (
                          <li class="lure">
                            <Tip>
                              <Icon name="fish" size={15} /> {lureInfo(s)[0]}
                              <Fragment slot="tip">
                                <span class="tip-title">Encantamiento Atracción</span>
                                <span class="tip-line">{lureInfo(s)[1]}</span>
                              </Fragment>
                            </Tip>
                          </li>
                        )}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>
          </details>
        ))
      )
    }

    <details class="legend">
      <summary>¿Cómo funciona la rareza?</summary>
      <p>
        Cada vez que el juego genera un Pokémon primero elige una <strong>categoría de rareza</strong> y luego, entre los
        Pokémon de esa categoría que cumplen las condiciones del lugar, elige uno según su <strong>peso</strong> (a mayor
        peso, más probable).
      </p>
      <ul>
        {
          Object.entries(meta.world).map(([k, v]) => (
            <li>
              <span class="rarity" style={`--r: ${BUCKETS[k][1]}`}>{BUCKETS[k][0]}</span> {v}% en el mundo
            </li>
          ))
        }
      </ul>
      <p>Al pescar, el nivel del encantamiento Atracción de la Poké Caña decide qué Pokémon pueden salir (cada uno pide un rango de nivel), y la baya que pongas de cebo hace más probables los de cierto tipo, grupo huevo o EV.</p>
    </details>
  </section>

  <nav class="pager" aria-label="Otros Pokémon">
    {
      prev ? (
        <a href={`/pokemon/${prev.slug}/`} class="pg" rel="prev">
          <Icon name="left" size={20} />
          <img src={`/img/thumb/${prev.id}.webp`} alt="" width="56" height="56" loading="lazy" />
          <span><small>Anterior · {num(prev.id)}</small><b>{prev.es}</b></span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={`/pokemon/${next.slug}/`} class="pg next" rel="next">
          <span><small>Siguiente · {num(next.id)}</small><b>{next.es}</b></span>
          <img src={`/img/thumb/${next.id}.webp`} alt="" width="56" height="56" loading="lazy" />
          <Icon name="right" size={20} />
        </a>
      )
    }
  </nav>
</Base>

<style>
  .ints {
    display: grid;
    gap: 12px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .crumbs .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    border-radius: 12px;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .crumbs a.btn:hover {
    transform: translateY(-2px);
  }
  .crumbs a.btn:active {
    transform: none;
  }
  .crumbs .icon {
    width: 40px;
    padding: 0;
  }
  .crumbs .off {
    opacity: 0.35;
    box-shadow: none;
  }
  .step {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .step b {
    min-width: 3.6em;
    text-align: center;
    font: 700 0.95rem var(--font-title);
    color: var(--muted);
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    margin: 12px 0 20px;
    padding: 16px;
    border-radius: var(--radius);
    background: radial-gradient(circle at 20% 40%, color-mix(in srgb, var(--c) 35%, transparent), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
  }
  .hero img {
    width: min(240px, 60vw);
    margin: 0 auto;
    filter: drop-shadow(0 8px 18px rgb(0 0 0 / 0.5));
  }
  .hero > div {
    flex: 1 1 260px;
  }
  .num {
    margin: 0;
    color: var(--muted);
    font: 600 0.95rem var(--font-title);
  }
  h1 {
    font-size: clamp(2rem, 7vw, 3rem);
    margin: 0;
  }
  .en {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .facts {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    margin-bottom: 28px;
  }
  .fact {
