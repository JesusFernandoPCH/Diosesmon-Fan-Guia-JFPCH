---
// Árbol evolutivo: tarjeta del Pokémon y, a su lado (abajo en móvil), cada evolución con sus requisitos.
import EvoWay from './EvoWay.astro';
import TypeChip from './TypeChip.astro';
import Icon from './Icon.astro';
import { biasRegion } from '../data/labels';
import { bySlug, childrenOf, isBias } from '../lib/evo';

interface Props {
  slug: string;
  current?: string; // resalta el Pokémon de la ficha actual
}
const { slug, current } = Astro.props;
const p = bySlug.get(slug)!;
const children = childrenOf(slug);
const SHOWN = 3; // formas de evolucionar visibles antes de "ver más"
---

<div class="node">
  <a href={`/pokemon/${p.slug}/`} class:list={['mon', { current: current === p.slug }]}>
    <img src={`/img/thumb/${p.id}.webp`} alt="" width="64" height="64" loading="lazy" data-vt={`mon-${p.id}`} />
    <span class="name">{p.es}</span>
    <span class="types">{p.types.map((t) => <TypeChip type={t} small />)}</span>
  </a>
  {
    children.length > 0 && (
      <div class="branches">
        {children.map(({ to, ways }) => {
          const normal = ways.filter((w) => !isBias(w));
          const bias = ways.filter(isBias);
          return (
          <div class="branch">
            <div class="arrow">
              {normal.slice(0, SHOWN).map((w) => (
                <EvoWay way={w} friendshipBase={p.friendship} />
              ))}
              {normal.length > SHOWN && (
                <details>
                  <summary>Ver {normal.length - SHOWN} formas más</summary>
                  {normal.slice(SHOWN).map((w) => (
                    <EvoWay way={w} friendshipBase={p.friendship} />
                  ))}
                </details>
              )}
              {bias.length > 0 && (
                <details class="bias">
                  <summary><Icon name="compass" size={16} /> Con tendencia de {biasRegion(bias[0].fromForm!)} ({bias.length})</summary>
                  <p>
                    Algunos {p.es} salvajes aparecen con <strong>tendencia de {biasRegion(bias[0].fromForm!)}</strong> según
                    el bioma donde nacen (lo verás en “Dónde aparece”). Esos evolucionan con estas reglas:
                  </p>
                  {bias.map((w) => (
                    <EvoWay way={w} friendshipBase={p.friendship} />
                  ))}
                </details>
              )}
            </div>
            <Astro.self slug={to} current={current} />
          </div>
          );
        })}
      </div>
    )
  }
</div>

<style>
  .node {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mon {
    align-self: flex-start;
    display: grid;
    justify-items: center;
    gap: 2px;
    width: 118px;
    padding: 8px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
  }
  .mon.current {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .mon img {
    width: 64px;
    height: 64px;
  }
  .name {
    font: 600 0.9rem var(--font-title);
    text-align: center;
  }
  .types {
    display: flex;
    gap: 3px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .branches {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-left: 18px;
    border-left: 2px solid var(--border);
  }
  .branch {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .arrow {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--surface-2) 60%, transparent);
  }
  .arrow::before {
    content: '↓';
    position: absolute;
    left: -16px;
    top: 6px;
    color: var(--accent);
    font-weight: 700;
  }
  .arrow > :global(.way + .way) {
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }
  details summary {
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--muted);
  }
  details > :global(.way) {
    margin-top: 6px;
  }
  .bias {
    margin-top: 4px;
    padding: 6px 8px;
    border-radius: 8px;
    border: 1px dashed var(--border);
  }
  .bias p {
    margin: 6px 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Escritorio: el árbol crece hacia la derecha */
  @media (min-width: 1000px) {
    .node {
      flex-direction: row;
      align-items: flex-start;
    }
    .branches {
      padding-left: 0;
      border-left: 0;
    }
    .branch {
      flex-direction: row;
      align-items: flex-start;
    }
    .arrow {
      width: 260px;
      margin-top: 18px;
    }
    .arrow::before {
      content: '→';
      left: auto;
      right: -16px;
      top: 8px;
    }
    .branch > :global(.node) {
      margin-left: 8px;
    }
  }
</style>
