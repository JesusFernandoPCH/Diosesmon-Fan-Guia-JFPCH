---
// Tarjeta de una fusión: imagen (o vista previa con los dos Pokémon), padres y, si se conocen, tipos, habilidades y estadísticas.
import { inPublic } from '../lib/public';
import TypeChip from './TypeChip.astro';
import Icon from './Icon.astro';
import { bySlug } from '../lib/evo';
import type { Fusion } from '../data/fusions';

interface Props {
  f: Fusion;
}
const { f } = Astro.props;
const parents = [bySlug.get(f.a)!, bySlug.get(f.b)!];
// imagen que pone el usuario en public/img/fusion/<slug>.webp (o .png)
const art = ['webp', 'png'].map((ext) => `/img/fusion/${f.slug}.${ext}`).find((src) => inPublic(src));
const STAT_SHORT = { hp: 'PS', attack: 'Atq', defence: 'Def', special_attack: 'At.Esp', special_defence: 'Def.Esp', speed: 'Vel' };
const total = Object.values(f.stats).reduce((a, b) => a + b, 0);
const pending = !f.types.length && !f.abilities.length && !f.hidden && !total;
---

<article class="fusion" id={f.slug} data-name={`${f.name} ${parents.map((p) => `${p.es} ${p.en}`).join(' ')}`.toLowerCase()}>
  <div class="art">
    {
      art ? (
        <img src={art} alt={f.name} width="140" height="140" loading="lazy" />
      ) : (
        <div class="preview" title="Imagen de la fusión aún no disponible">
          <img class="pa" src={`/img/art/${parents[0].id}.webp`} alt="" width="96" height="96" loading="lazy" />
          <img class="pb" src={`/img/art/${parents[1].id}.webp`} alt="" width="96" height="96" loading="lazy" />
          <span class="q">?</span>
        </div>
      )
    }
  </div>
  <div class="info">
    <h3>{f.name}</h3>
    <div class="parents">
      {
        parents.map((p, i) => (
          <>
            {i > 0 && <span class="plus">+</span>}
            <a href={`/pokemon/${p.slug}/`} class="parent">
              <img src={`/img/thumb/${p.id}.webp`} alt="" width="40" height="40" loading="lazy" />
              <span>{p.es}</span>
            </a>
          </>
        ))
      }
    </div>
    {f.types.length > 0 && <div class="row">{f.types.map((t) => <TypeChip type={t} small />)}</div>}
    {
      (f.abilities.length > 0 || f.hidden) && (
        <div class="row">
          Habilidades:{' '}
          <strong>
            {f.abilities.join(', ')}
            {f.hidden && (
              <>
                {f.abilities.length > 0 && ', '}
                <em title="Habilidad oculta">{f.hidden}</em> <span class="hid">(oculta)</span>
              </>
            )}
          </strong>
        </div>
      )
    }
    {pending && <p class="pending"><Icon name="clipboard" size={15} /> Datos pendientes</p>}
    {
      total > 0 && (
        <details class="stats">
          <summary>
            Estadísticas: <strong>{total}</strong>
          </summary>
          <table>
            {(Object.keys(STAT_SHORT) as (keyof typeof STAT_SHORT)[]).map((k) => (
              <tr>
                <th>{STAT_SHORT[k]}</th>
                <td class="bar">
                  <span style={`width: ${Math.min(100, (f.stats[k] / 200) * 100)}%`} />
                </td>
                <td>{f.stats[k]}</td>
              </tr>
            ))}
          </table>
        </details>
      )
    }
  </div>
</article>

<style>
  .fusion {
    display: flex;
    gap: 12px;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .art {
    flex: none;
    width: 110px;
  }
  .art > img {
    width: 110px;
    height: 110px;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.45));
  }
  .preview {
    position: relative;
    width: 110px;
    height: 110px;
    border-radius: 12px;
    background: radial-gradient(circle, color-mix(in srgb, #7ad3e8 25%, transparent), transparent 70%);
  }
  .preview img {
    position: absolute;
    width: 72px;
    height: 72px;
    opacity: 0.85;
  }
  .pa {
    left: 0;
    top: 4px;
  }
  .pb {
    right: 0;
    bottom: 4px;
  }
  .q {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #7ad3e8;
    color: #0b1220;
    font: 700 1.1rem var(--font-title);
  }
  .info {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .parents {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .parent {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }
  .plus {
    color: #7ad3e8;
    font-weight: 700;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    font-size: 0.85rem;
  }
  .hid {
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .pending {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .stats {
    font-size: 0.82rem;
  }
  .stats summary {
    cursor: pointer;
    color: var(--muted);
  }
  table {
    width: 100%;
    margin-top: 6px;
    border-collapse: collapse;
  }
  th {
    width: 4.5em;
    text-align: left;
    font-weight: 400;
    color: var(--muted);
  }
  td {
    padding: 1px 4px;
    text-align: right;
  }
  .bar {
    width: 100%;
  }
  .bar span {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, #7ad3e8, #5b8def);
  }
</style>
